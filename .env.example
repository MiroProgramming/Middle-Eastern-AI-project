# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# ---------- Brain (required) ----------
# Get a key at https://console.anthropic.com (API billing is separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=
# Everyday model (cheap + capable). For ultra-cheap use claude-haiku-5-5.
CUPPY_MODEL=claude-sonnet-5-5
CUPPY_EFFORT=medium
# Used only for /deep questions.
CUPPY_DEEP_MODEL=claude-opus-5-5
CUPPY_DEEP_EFFORT=high
# Background chores (summaries).
CUPPY_CHEAP_MODEL=claude-haiku-5-5
# Messages kept before Cuppy summarises and starts fresh. Lower = cheaper.
CUPPY_MAX_HISTORY=40
# Monthly AI budget in USD. Once reached, Cuppy switches to the cheap model. 0 = no cap.
MONTHLY_BUDGET_USD=20

# ---------- About you ----------
OWNER_NAME=
# Your timezone, e.g. Africa/Cairo, Asia/Dubai, Europe/London
TIMEZONE=UTC
# A sentence or two Cuppy should always know about you.
OWNER_ABOUT=Medical student. Likes concise answers.

# ---------- Chat apps (set up at least one) ----------
# Telegram: create a bot with @BotFather. Leave OWNER_ID empty at first; the bot will tell you yours.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Discord: https://discord.com/developers/applications (enable "Message Content Intent").
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# Where reminders go by default: telegram | discord | whatsapp
DEFAULT_NOTIFY_CHANNEL=telegram

# ---------- Phone calls + WhatsApp (Twilio, optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Cuppy's phone number (from Twilio), in +countrycode format
TWILIO_PHONE_NUMBER=
# Cuppy's WhatsApp sender (Twilio sandbox number while testing)
TWILIO_WHATSAPP_NUMBER=
# YOUR number, in +countrycode format
OWNER_PHONE_NUMBER=
# Only if your WhatsApp number differs from OWNER_PHONE_NUMBER
OWNER_WHATSAPP_NUMBER=
TWILIO_VOICE=Polly.Matthew
# Public https address of your server (needed for incoming WhatsApp messages)
PUBLIC_BASE_URL=

# ---------- Moodle (optional) ----------
# Run: python scripts/moodle_token.py https://moodle.youruniversity.edu
MOODLE_URL=
MOODLE_TOKEN=

# ---------- Google (optional) ----------
# Run scripts/google_auth.py; it creates data/google_token.json automatically.
# GOOGLE_TOKEN_FILE=data/google_token.json

# ---------- Extras ----------
# Daily morning briefing at this local time (HH:MM). Empty = off.
BRIEFING_TIME=07:30
WEB_PORT=8080
DATA_DIR=data
